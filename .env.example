# Optional dev fallback for Cloudinary (unsigned uploads).
# Prefer configuring cloud name + upload preset under Business Settings → Media (Cloudinary)
# in the app (stored per business in Firebase). See `src/lib/businessSettingsPath.ts`.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# Never put API Key or API Secret in VITE_* variables — they ship to the browser.
